# Public origin: replace before production. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Supabase Project Settings > API / Connect. These two values are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server ONLY: modern sb_secret_... key, or legacy service_role key.
SUPABASE_SECRET_KEY=
# Set true only after enabling the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
